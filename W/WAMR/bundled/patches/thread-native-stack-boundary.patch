+/* Per-thread override of the native stack boundary used for exec envs created
+   on this thread (including the ones the runtime creates internally, e.g. to
+   run start functions). For embedders whose "threads" run on their own stacks. */
+static os_thread_local_attribute uint8 *thread_native_stack_boundary = NULL;
+
+void
+wasm_runtime_set_thread_native_stack_boundary(uint8_t *native_stack_boundary)
+{
+    thread_native_stack_boundary = native_stack_boundary;
+}
+
