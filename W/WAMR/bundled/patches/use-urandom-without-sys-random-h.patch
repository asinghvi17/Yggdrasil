Fall back to /dev/urandom when <sys/random.h> is not available.

`CONFIG_HAS_GETRANDOM` assumes that every Linux libc other than glibc < 2.25 provides
`getrandom()` and <sys/random.h>. This is not true for musl < 1.1.20 (as used by
BinaryBuilder, musl 1.1.19): the header is missing and compilation of random.c fails.
Use `__has_include` to select the existing /dev/urandom fallback in that case.

This should be sent upstream (no upstream issue/PR exists yet).

diff --git a/core/iwasm/libraries/libc-wasi/sandboxed-system-primitives/src/ssp_config.h b/core/iwasm/libraries/libc-wasi/sandboxed-system-primitives/src/ssp_config.h
index 8296772..da288f0 100644
--- a/core/iwasm/libraries/libc-wasi/sandboxed-system-primitives/src/ssp_config.h
+++ b/core/iwasm/libraries/libc-wasi/sandboxed-system-primitives/src/ssp_config.h
@@ -36,7 +36,8 @@
     || ((defined(__linux__) || defined(ESP_PLATFORM) \
          || defined(__COSMOPOLITAN__))               \
         && (!defined(__GLIBC__) || __GLIBC__ > 2     \
-            || (__GLIBC__ == 2 && __GLIBC_MINOR__ >= 25)))
+            || (__GLIBC__ == 2 && __GLIBC_MINOR__ >= 25)) \
+        && (!defined(__has_include) || __has_include(<sys/random.h>)))
 #define CONFIG_HAS_GETRANDOM 1
 #else
 #define CONFIG_HAS_GETRANDOM 0
